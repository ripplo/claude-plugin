{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook session-preamble"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook plan-reminder"
          },
          {
            "type": "command",
            "command": "npx ripplo hook coverage-nudge"
          },
          {
            "type": "command",
            "command": "npx ripplo hook scope-reminder"
          },
          {
            "type": "command",
            "command": "npx ripplo hook track-skill-prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook post-edit-lint"
          },
          {
            "type": "command",
            "command": "npx ripplo hook post-edit-flag-stubs"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook track-skill-load"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook exit-plan-gate"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook pre-edit-watch-gate"
          },
          {
            "type": "command",
            "command": "npx ripplo hook pre-edit-scope-gate"
          },
          {
            "type": "command",
            "command": "npx ripplo hook pre-edit-ripplo-skill-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook pre-bash-hooks-pause-gate"
          },
          {
            "type": "command",
            "command": "npx ripplo hook pre-bash-run-gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx ripplo hook stop-enforce",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
